{
  "consumer": {
    "name": "BooksCatalogue"
  },
  "provider": {
    "name": "CoursesCatalogue"
  },
  "interactions": [
    {
      "providerState": "courses exist",
      "description": "getting all courses details",
      "request": {
        "method": "GET",
        "path": "/allCourseDetails"
      },
      "response": {
        "status": 200,
        "body": [
          {
            "price": 10
          },
          {
            "price": 10
          },
          {
            "price": 10
          }
        ],
        "matchingRules": {
          "$.body": {
            "match": "type",
            "min": 3
          },
          "$.body.price": {
            "match": "type"
          }
        }
      }
    },
    {
      "providerState": "Course Appium exist",
      "description": "Get the Appium course details",
      "request": {
        "method": "GET",
        "path": "/getCourseByName/Appium"
      },
      "response": {
        "status": 200,
        "body": {
          "price": 44,
          "category": "mobile"
        },
        "matchingRules": {
          "$.body.price": {
            "match": "type"
          },
          "$.body.category": {
            "match": "type"
          }
        }
      }
    },
    {
      "providerState": "Course Appium does not exist",
      "description": "Appium course Does not exist",
      "request": {
        "method": "GET",
        "path": "/getCourseByName/Appium"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    }
  }
}